{
  "name": "paseo-linear-tickets",
  "version": "0.4.0",
  "description": "Paseo sidebar plugin that lists your assigned Linear tickets and starts an agent with the ticket context, comments and relationships.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vokturz/paseo-plugins.git",
    "directory": "linear-tickets"
  },
  "type": "module",
  "files": [
    "npm-shrinkwrap.json",
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "scripts/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate:icons": "node scripts/generate-provider-icons.mjs",
    "test": "node --import tsx --test server/*.test.ts client/*.test.ts scripts/*.test.mjs && python3 -m unittest discover -s ops -p 'test_*.py'",
    "tier-report": "node scripts/tier-report.mjs",
    "smoke:planning": "node scripts/planning-smoke.mjs"
  },
  "dependencies": {
    "simple-icons": "^16.30.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@getpaseo/client": "0.8.0",
    "@getpaseo/plugin": "0.8.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
